  "narrative": {
    "northStar": "The Quiet Shelf",
    "overview": "The window is a dark cabinet with a list of steps on the left and one screen on the right. The covers are the only things allowed to be colourful; the interface around them is deep blue-black, one step lighter for cards, with a single sky-blue voice for the action that matters now.",
    "keyCharacteristics": [
      "Dark tonal layering with soft shadows under cards.",
      "One accent (sky blue); green, amber and coral appear only as status.",
      "Fully rounded buttons and chips, softly rounded cards.",
      "A preview of the cover beside every choice that changes it.",
      "Accessible by construction: visible control edges, a focus ring, names for screen readers, nothing wider than its card."
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "Sky blue marks the single action or state that matters right now.",
        "section": "colors"
      },
      {
        "name": "The Covers Are Colorful Rule",
        "body": "The interface stays in the navy family so the cover thumbnails are the most saturated thing on screen.",
        "section": "colors"
      },
      {
        "name": "The Colour Is Never Alone Rule",
        "body": "A finished step also shows a tick, a locked one a padlock; a disabled control is shown at 60%.",
        "section": "colors"
      },
      {
        "name": "The Wider Font Rule",
        "body": "Labels wrap, buttons never exceed their card, long text is cut with an ellipsis.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do keep one sky-blue primary action per screen and everything else quiet.",
      "Do say what will happen before it happens, and what was done after.",
      "Do take every size, colour and duration from Theme.qml.",
      "Do keep outlines of enabled controls at 3:1 against the card and show a ring on keyboard focus.",
      "Do keep status colours for status only."
    ],
    "donts": [
      "Don't put the Steam logo in the app icon or window chrome.",
      "Don't introduce a second accent colour or a custom typeface.",
      "Don't use jargon or hide recovery: backups and undo stay stated up front.",
      "Don't put text inside a shadow effect or place anything on a half pixel.",
      "Don't let the layout depend on a large screen."
    ]
  }
